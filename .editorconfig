root = true

[*]
end_of_line = crlf
insert_final_newline = true
charset = utf-8
indent_style = space
trim_trailing_whitespace = true
vsspell_ignored_keywords = adapter|aot|bgra|brotli|dpi|dxgi|gdi|gpu|hresult|iid|interop|latency|letterbox|lossless|luma|nscreen|pinvoke|pitch|rects|rgb|staging|stdcall|struct|vtable|winapi|winmm|x64


[*.{config,json}]
indent_size = 2
