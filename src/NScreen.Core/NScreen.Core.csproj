<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything both sides share: the wire formats and a little CLI plumbing.
    Plain net10.0 with no OS-specific API in it, because the client has to run on macOS.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NScreen</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

</Project>
