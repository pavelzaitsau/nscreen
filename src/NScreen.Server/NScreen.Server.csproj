<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The screen source. Windows-only by nature: DXGI Desktop Duplication has no equivalent here,
    and the hand-written COM interop assumes 64-bit vtables, hence the x64 PlatformTarget.
    Deliberately knows nothing about windows or rendering - it links neither user32 nor gdi32.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>nscreen-server</AssemblyName>
    <RootNamespace>NScreen.Server</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NScreen.Core\NScreen.Core.csproj" />
  </ItemGroup>

</Project>
