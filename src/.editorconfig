# Style Cop rules
dotnet_diagnostic.SA0001.severity = none # XML comment analysis is disabled
dotnet_diagnostic.SA1101.severity = none # Prefix local calls with this
dotnet_diagnostic.SA1117.severity = none # Parameters should be on same line or separate lines
dotnet_diagnostic.SA1124.severity = none # Do not use regions
dotnet_diagnostic.SA1201.severity = none # An element should appear before the elements of a certain kind in a C# code file.
dotnet_diagnostic.SA1202.severity = none # An element within a C# code file is out of order within regard to access level, in relation to other elements in the code.
dotnet_diagnostic.SA1204.severity = none # A static element is positioned beneath an instance element.
dotnet_diagnostic.SA1206.severity = none # The keywords within the declaration of an element do not follow a standard ordering scheme.
dotnet_diagnostic.SA1306.severity = none # Field names should begin with lower-case letter
dotnet_diagnostic.SA1309.severity = none # Field names should not begin with an underscore
dotnet_diagnostic.SA1313.severity = none # The name of a parameter in C# does not begin with a lower-case letter.
dotnet_diagnostic.SA1413.severity = suggestion # Use trailing comma in multi-line initializers
dotnet_diagnostic.SA1512.severity = none # A single-line comment within C# code is followed by a blank line
dotnet_diagnostic.SA1515.severity = none # A single-line comment within C# code should be preceded by a blank line
dotnet_diagnostic.SA1600.severity = none # Elements should be documented
dotnet_diagnostic.SA1601.severity = none # Partial elements should be documented
dotnet_diagnostic.SA1602.severity = none # Enumeration items should be documented
dotnet_diagnostic.SA1611.severity = none # A C# method, constructor, delegate or indexer element is missing documentation for one or more of its parameters
dotnet_diagnostic.SA1615.severity = none # A C# element is missing documentation for its return value.
dotnet_diagnostic.SA1629.severity = none # Documentation text should end with a period
dotnet_diagnostic.SA1633.severity = none # File must have header
dotnet_diagnostic.SA1623.severity = none # Property summary documentation should match accessors
dotnet_diagnostic.SA1123.severity = none # Region should not be located within a code element
dotnet_diagnostic.SA1118.severity = none # Parameters should not span multiple lines

# Meziantou.Analyzer
dotnet_diagnostic.MA0001.severity = none # StringComparison is missing
dotnet_diagnostic.MA0002.severity = none # IEqualityComparer<string> or IComparer<string> is missing
dotnet_diagnostic.MA0003.severity = none # Add parameter name to improve readability
dotnet_diagnostic.MA0004.severity = none # Use Task.ConfigureAwait(false) if the current SynchronizationContext is not needed
dotnet_diagnostic.MA0006.severity = none # Use string.Equals instead of Equals operator
dotnet_diagnostic.MA0007.severity = suggestion # Add a comma after the last value
dotnet_diagnostic.MA0011.severity = none # IFormatProvider is missing
dotnet_diagnostic.MA0015.severity = none # Specify the parameter name in ArgumentException
dotnet_diagnostic.MA0016.severity = none # Prefer using collection abstraction instead of implementation
dotnet_diagnostic.MA0021.severity = none # Use an explicit StringComparer to compute hash codes
dotnet_diagnostic.MA0023.severity = none # Add RegexOptions.ExplicitCapture
dotnet_diagnostic.MA0026.severity = none # TODO. Similar to S1135
dotnet_diagnostic.MA0042.severity = none # Do not use blocking calls in an async method. Similar to S6966
dotnet_diagnostic.MA0048.severity = none # File name must match type name. Similar to SA1649
dotnet_diagnostic.MA0051.severity = none # Method is too long
dotnet_diagnostic.MA0055.severity = none #  Do not use finalizer
dotnet_diagnostic.MA0072.severity = none # Do not throw from a finally block. Similar to CA2219
dotnet_diagnostic.MA0074.severity = none # Use an overload of 'StartsWith' that has a StringComparison parameter
dotnet_diagnostic.MA0076.severity = none # Do not use implicit culture-sensitive ToString in interpolated strings
dotnet_diagnostic.MA0132.severity = none # Do not convert implicitly to DateTimeOffset
dotnet_diagnostic.MA0169.severity = none # Use Equals method instead of operator
dotnet_diagnostic.MA0176.severity = none # Optimize guid creation

# SharpSource
dotnet_diagnostic.SS003.severity = suggestion # The operands of a divisive expression are both integers and result in an implicit rounding
dotnet_diagnostic.SS004.severity = none # Implement Equals() and GetHashcode() methods for a type used in a collection
dotnet_diagnostic.SS018.severity = suggestion # Add cases for missing enum member
dotnet_diagnostic.SS019.severity = suggestion # Switch should have default label
dotnet_diagnostic.SS021.severity = none # Method might be missing a test attribute
dotnet_diagnostic.SS025.severity = none # An exception is thrown from a finally block; Similar to S1163 and CA2219
